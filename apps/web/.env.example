# Salin ke .env.local lalu isi.
# Rahasia penanda tangan cookie sesi, minimal 32 karakter acak:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password awal untuk semua pengguna contoh dari `pnpm db:seed` (wajib diganti saat login pertama).
SEED_PASSWORD=

# Opsional: lokasi folder data PGlite (default: apps/web/.data/pglite)
# PGLITE_DIR=
